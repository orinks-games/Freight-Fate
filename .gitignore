__pycache__/
.venv/
.route-cache/

# Editors
.vscode/
.idea/
*.swp

# Claude Code local overrides (per-machine, not for commit)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
live_*.txt

# Licensed sound-library material. NEVER COMMIT THESE.
#
# Purchased SFX libraries (Big Fish Audio / Pro Sound Effects and similar)
# grant synchronization rights -- the right to use the audio inside a finished
# production. That covers shipping them inside the game. It does not cover
# redistributing the source files, and a public repo does exactly that. The
# licence is also per-seat and non-transferable, so a file in this tree would
# be handing a copy to everyone who clones.
#
# Drop purchased material in assets/sounds-licensed/ and it stays local. The
# release packer overlays it on top of assets/sounds/, so a build made on a
# machine that owns the library gets the licensed audio while a clean clone
# still builds and runs on the synthesized fallbacks.
assets/sounds-licensed/
# The old src/ tree (overlay, loose sounds, music.pak, caches): nothing under
# src/ is ever committed again, so a checkout that still has it stays safe.
/src/
sound-source/
*.wav
# ...except the cab-filter test fixtures. They are inputs to `include_bytes!`,
# so without them ff-core does not COMPILE -- a fresh clone could not build or
# test the crate at all, which is what the blanket rule above was quietly
# causing. 124 KB of generated tone, and the code that reads them is the only
# thing that ever will.
!crates/ff-core/src/cab_filter/fixtures/*.wav
# The shipped audio is assets/sounds.pak (cargo tools pack-sounds).
# music.pak is a private builder-local release asset downloaded when needed.
assets/music.pak
# Channel 3000's clips (tools/build_channel3000.py); downloaded like music.pak.
assets/channel3000.pak
# The loose assets/sounds tree is builder-local source material and never
# ships through the repo (owner, 2026-08-08); only the credits ride along
# so licensing stays reviewable in a clean clone.
assets/sounds/**
!assets/sounds/CREDITS.md
# The classic engine voice (donated 1.8.x recording) is player-selectable in
# Settings, not builder-local material, so it ships through the repo where
# the licensed overlay can never shadow it. Only the one shipped file is
# un-ignored -- anything else dropped in that directory stays uncommittable.
!assets/sounds/engine_classic/
assets/sounds/engine_classic/**
!assets/sounds/engine_classic/idle.ogg

# Prototype/audition renders
sound-test/*.wav
sound-test/render-cab/

# Portable save data (lives in the game directory)
saves/

# here.now publish state (contains claimToken write-secret)
.herenow_site.json

# Build-time secrets (ORS_API_KEY for OpenRouteService driving-hgv enrichment).
# Never bundled or read at runtime; sourced only by the route tooling.
.env

# Local API key notes used by asset-generation tooling.
AI API Keys.txt
*API Keys*.txt

# ChatGPT signsheet batch staging (transient)
data/spider/signsheets/batch*/
data/spider/signsheets/*.zip

# local scratch status (not for commit)
STATUS.md

logs/
.cache/

# personal play/test launchers (owner-local, not for commit)
FF*.ps1

# Codebuff desktop app data
.freebuff/

# Windows null device artifact
nul

# Claude Code per-machine state. A shared .claude/settings.json or agent
# definition can still be committed; only the local-only bits are ignored.
.claude/settings.local.json
.claude/worktrees/
# Cached source dumps for tools/import_radio_catalog.py
data/radio-cache/

# ElevenLabs voice-provisioning cache (name -> voice_id on the owner's account)
tools/.radio_voices.json

# Manual-playtest sandbox data dir (freightfate --playtest-sandbox). Throwaway
# careers, no driver identity, never for commit.
saves-playtest/
# Agent-server data dirs: the retired --online one held a real driver
# identity; --staging's holds a staging driver. Never for commit.
saves-agent-online/
saves-agent-staging/

# Rust
target/

# OSM readings behind the curve connector bake (tools/curve_osm_facts.py).
# 26 MB of derived cache: one deterministic offline pass over the local
# Geofabrik extracts, regenerated with `--all` whenever the rule is re-judged.
# The decision it feeds IS committed -- every connector row in curves.jsonl
# carries the connector_source that flagged it.
data/world_data/us/gameplay/curve_osm.jsonl
# Local linked worktrees used by agentic implementation plans.
.worktrees/

# Local code-review reports (paad); findings land in commits and ROADMAP instead.
paad/

# Apple signing material made on a developer's machine. Keep it out of
# commits even when someone runs `git add -A` at the repository root.
*.certSigningRequest
*.p12
*.mobileprovision
*.cer

msgstr "Khôi phục bản sao lưu cũ hơn: {backed_up_text}"

msgid ". From an earlier version of Freight Fate"
msgstr ". Từ phiên bản Freight Fate cũ hơn"

msgid "Replaces the local save with this older backup."
msgstr "Thay bản lưu trên máy bằng bản sao lưu cũ hơn này."

msgid "This is your public career"
msgstr "Đây là hồ sơ sự nghiệp công khai của bạn"

msgid ""
"When Profile sharing is on, approved facts from this career's accepted "
"backups appear on your public profile. Your other careers stay private "
"cloud backups."
msgstr ""
"Khi Chia sẻ hồ sơ đang bật, các thông tin được duyệt từ bản sao lưu hợp lệ "
"của hồ sơ này sẽ hiện trên hồ sơ công khai của bạn. Các hồ sơ khác vẫn là "
"bản sao lưu đám mây riêng tư."

msgid "Make this your public career"
msgstr "Đặt làm hồ sơ sự nghiệp công khai"

msgid ""
"Your public profile shows one career. The others stay private cloud backups."
msgstr ""
"Hồ sơ công khai chỉ hiển thị một sự nghiệp. Các hồ sơ khác vẫn là bản sao "
"lưu đám mây riêng tư."

msgid "Delete this career's cloud backups"
msgstr "Xóa các bản sao lưu đám mây của hồ sơ này"

msgid ""
"Removes every kept cloud backup of this career from your orinks.net "
"account. The save on this computer is not touched."
msgstr ""
"Gỡ toàn bộ bản sao lưu đám mây đang giữ của hồ sơ sự nghiệp này khỏi tài "
"khoản orinks.net. Bản lưu trên máy này không bị ảnh hưởng."

msgid "Cloud backup is still working. Stay here for the result."
msgstr ""
"Sao lưu đám mây vẫn đang xử lý. Hãy ở lại màn hình này để nghe kết quả."


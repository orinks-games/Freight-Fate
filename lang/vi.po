msgstr ""

#. placeholders: {on_off}
msgid "Speak mountain passes: {on_off}"
msgstr ""

msgid ""
"Callouts approaching a named mountain pass, and famous highway markers like "
"the Loneliest Road in America."
msgstr ""

#. placeholders: {on_off}

#. placeholders: {sentence_start}, {current}
msgid "{sentence_start}. Press another, or keep {current} with Escape."
msgstr ""
"{sentence_start}. Nhấn phím khác, hoặc giữ nguyên {current} bằng Escape."

msgid "Every keyboard shortcut is back to its default."
msgstr "Mọi phím tắt bàn phím đã được khôi phục về mặc định."

msgid "Every controller button is back to its default."
msgstr "Mọi nút tay cầm đã được khôi phục về mặc định."

msgid ""
"Enter, then press the key you want for this control. Escape keeps the one "
"it has."
msgstr ""
"Nhấn Enter, rồi bấm phím bạn muốn gán cho chức năng này. Nhấn Escape để giữ "
"phím hiện tại."

msgid ""
"Enter, then press the button you want for this control, with the right "
"bumper held for the second layer."
msgstr ""
"Nhấn Enter, rồi bấm nút bạn muốn gán cho chức năng này, giữ nút vai phải để "
"dùng lớp nút thứ hai."

msgid "Reset every keyboard shortcut to its default"
msgstr "Đặt lại toàn bộ phím tắt bàn phím về mặc định"

msgid "Reset every controller button to its default"
msgstr "Đặt lại toàn bộ nút tay cầm về mặc định"

msgid "Puts every control on this screen back where it started."
msgstr "Đưa mọi phím điều khiển trên màn hình này về trạng thái ban đầu."

msgid ""
"Move up and down to pick a gesture, then confirm it to choose the command "
"it runs while driving. Go back to leave."
msgstr ""
"Vuốt lên xuống để chọn cử chỉ, rồi xác nhận để chọn lệnh thực hiện khi lái "
"xe. Quay lại để thoát."

msgid "Gesture"
msgstr "Cử chỉ"

msgid "Every touch gesture is back to its default."
msgstr "Mọi cử chỉ cảm ứng đã được khôi phục về mặc định."

msgid "Touch haptics enabled."
msgstr "Đã bật rung phản hồi cảm ứng."

msgid "Touch haptics disabled."
msgstr "Đã tắt rung phản hồi cảm ứng."

msgid "Confirm, then choose the command this gesture runs while driving."
msgstr "Xác nhận, rồi chọn lệnh mà cử chỉ này thực hiện khi lái xe."

msgid "Practice gestures"
msgstr "Luyện tập cử chỉ"

msgid ""
"Names each gesture and its current command without controlling the truck."
msgstr "Đọc tên từng cử chỉ và lệnh hiện tại mà không làm xe di chuyển."

#. placeholders: {else}
msgid "Touch haptics: {else}"
msgstr "Rung phản hồi cảm ứng: {else}"

msgid ""
"Light feedback confirms pedals and commands. Emergency braking warns."
msgstr ""
"Rung nhẹ để xác nhận bàn đạp và lệnh. Rung cảnh báo khi phanh khẩn cấp."

msgid "Reset every touch gesture to its default"
msgstr "Đặt lại toàn bộ cử chỉ cảm ứng về mặc định"

msgid "Puts every gesture on this screen back where it started."
msgstr "Đưa mọi cử chỉ trên màn hình này về trạng thái ban đầu."

msgid ""
"Move up and down to pick a command and confirm to put it on the gesture. "
"Going back keeps the one it has."
msgstr ""
"Vuốt lên xuống để chọn lệnh và xác nhận để gán cho cử chỉ. Quay lại để giữ "
"lệnh hiện tại."

#. placeholders: {gesture_name}, {label}
msgid "{gesture_name} now runs {label}."
msgstr "{gesture_name} hiện chạy lệnh {label}."

msgid "Swipe up and hold: gas. Lift to coast."
msgstr "Vuốt lên và giữ: đạp ga. Nhấc tay để thả trôi."

msgid "Swipe down and hold: brake."
msgstr "Vuốt xuống và giữ: đạp phanh."

msgid "Swipe left and hold: steer left."
msgstr "Vuốt trái và giữ: đánh lái sang trái."

msgid "Swipe right and hold: steer right."
msgstr "Vuốt phải và giữ: đánh lái sang phải."

msgid "Deep swipe down: emergency brake, or the parking brake when stopped."
msgstr ""
"Vuốt sâu xuống: phanh khẩn cấp, hoặc cài phanh đỗ khi xe đã dừng hẳn."

msgid "Hold still: straighten the wheel."
msgstr "Giữ yên ngón tay: trả thẳng lái."

msgid "Emergency brake."
msgstr "Phanh khẩn cấp."

msgid "Two-finger hold: horn."
msgstr "Chạm giữ hai ngón: bấm còi."

msgid "Two-finger turn right: start the engine."
msgstr "Xoay hai ngón sang phải: đề máy."

msgid "Two-finger turn left: stop the engine."
msgstr "Xoay hai ngón sang trái: tắt máy."

msgid "Second finger, hold left: steer left."
msgstr "Ngón thứ hai, giữ bên trái: đánh lái sang trái."

msgid "Second finger, hold right: steer right."
msgstr "Ngón thứ hai, giữ bên phải: đánh lái sang phải."

msgid "Practice touch gestures?"
msgstr "Luyện tập cử chỉ cảm ứng?"

#. one sentence of a longer line
msgid "Before your first drive, practice the touch gestures?"
msgstr ""
"Trước chuyến lái đầu tiên, bạn có muốn luyện tập cử chỉ cảm ứng không?"

#. placeholders: {current_text}
msgid ""
"Before your first drive, practice the touch gestures? Practice names each "
"gesture without moving the truck. {current_text}"
msgstr ""
"Trước chuyến lái đầu tiên, bạn có muốn luyện tập cử chỉ cảm ứng không? Chế "
"độ luyện tập sẽ đọc tên từng cử chỉ mà không làm xe di chuyển. "
"{current_text}"

#. one sentence of a longer line
msgid "Practice names each gesture without moving the truck."
msgstr "Chế độ luyện tập sẽ đọc tên từng cử chỉ mà không làm xe di chuyển."

msgid "Skip and start driving"
msgstr "Bỏ qua và bắt đầu lái"

msgid "Swipe down with two fingers twice within two seconds to leave."
msgstr "Vuốt xuống bằng hai ngón hai lần trong vòng hai giây để thoát."

msgid "Escape twice within two seconds to leave."
msgstr "Nhấn Escape hai lần trong vòng hai giây để thoát."

#. one sentence of a longer line
msgid "A flick is one step."
msgstr "Hất nhẹ là đi một nấc."

#. one sentence of a longer line
msgid "A swipe and hold is continuous."
msgstr "Vuốt và giữ là tác động liên tục."

#. one sentence of a longer line
msgid "Gestures are named but do not control the truck."
msgstr "Các cử chỉ sẽ được đọc tên nhưng không điều khiển xe."

#. one sentence of a longer line
msgid "Practice gestures."
msgstr "Luyện tập cử chỉ."

#. placeholders: {leave}
msgid ""
"Practice gestures. A flick is one step. A swipe and hold is continuous. Try "
"a flick up, then swipe up and hold. Gestures are named but do not control "
"the truck. {leave}"
msgstr ""
"Luyện tập cử chỉ. Hất nhẹ là đi một nấc. Vuốt và giữ là tác động liên tục. "
"Hãy thử hất nhẹ lên, rồi vuốt lên và giữ. Các cử chỉ sẽ được đọc tên nhưng "
"không điều khiển xe. {leave}"

#. one sentence of a longer line
msgid "Try a flick up, then swipe up and hold."
msgstr "Hãy thử hất nhẹ lên, rồi vuốt lên và giữ."


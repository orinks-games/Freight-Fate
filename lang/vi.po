msgid "rig"
msgstr ""

msgid "Northstar Freight Lines"
msgstr "Northstar Freight Lines"

msgid "Yard Trainee"
msgstr "Tài xế tập sự tại bãi"

msgid "Company driver"
msgstr "Tài xế hãng"

msgid "Starter company tractor and short regional dispatches."
msgstr "Xe đầu kéo cơ bản của hãng và các chuyến điều phối ngắn trong vùng."

msgid "Learning company procedures with carrier-paid equipment."
msgstr "Làm quen quy trình của hãng trên xe do hãng chi trả."

msgid "New Hire Company Driver"
msgstr "Tài xế hãng mới tuyển"

msgid ""
"Refrigerated and flatbed securement certificates from carrier training."
msgstr ""
"Chứng chỉ đào tạo chở hàng lạnh và chằng buộc hàng sàn phẳng do hãng cấp."

msgid "Running short freight with company dispatch and company equipment."
msgstr "Chạy các chuyến hàng ngắn theo điều phối và xe của hãng."

msgid "Solo Company Driver"
msgstr "Tài xế hãng chạy đơn"

msgid "Heavy-haul freight certificate."
msgstr "Chứng chỉ đào tạo chở hàng nặng."

msgid "Trusted for solo regional work and heavier freight."
msgstr "Được tin tưởng chạy tuyến nội vùng một mình và chở hàng nặng hơn."

msgid "Regional Company Driver"
msgstr "Tài xế hãng chạy nội vùng"

msgid ""
"High-value freight certificate, and dispatch moves you up to the regional "
"fleet: a few newer spare tractors, with the one that suits each load "
"assigned to you."
msgstr ""
"Chứng chỉ đào tạo chở hàng giá trị cao, và điều phối đưa bạn lên đội xe nội "
"vùng: gồm vài xe đầu kéo dự bị đời mới hơn, giao chiếc phù hợp cho từng lô "
"hàng."

msgid ""
"Working broader lanes while the carrier still owns the business risk."
msgstr "Chạy các tuyến rộng hơn trong khi hãng vẫn gánh rủi ro kinh doanh."

msgid "Regional Regular"
msgstr "Tài xế nội vùng quen tuyến"

msgid ""
"One extra assigned-load decline per promotion, and broader regional lane "
"variety."
msgstr ""
"Thêm một lượt từ chối đơn hàng được giao sau mỗi lần thăng cấp, cùng nhiều "
"tuyến nội vùng đa dạng hơn."

msgid "A dependable company driver, still on assigned carrier equipment."
msgstr "Tài xế hãng đáng tin cậy, vẫn chạy xe được hãng giao."

msgid "Experienced Company Driver"
msgstr "Tài xế hãng có kinh nghiệm"

msgid "The dispatch board now shows six offers per visit."
msgstr "Bảng đơn hàng giờ hiển thị sáu chuyến đề xuất mỗi lần xem."

msgid "Building miles, reputation, and savings on carrier equipment."
msgstr "Tích lũy số dặm chạy, uy tín và tiền tiết kiệm trên xe của hãng."

msgid "Long-Haul Company Driver"
msgstr "Tài xế hãng chạy đường dài"

msgid ""
"Long-haul dispatch becomes routine, with haul-length limits still growing "
"every level."
msgstr ""
"Chạy tuyến đường dài dần trở thành quen thuộc, với giới hạn cự ly tiếp tục "
"tăng sau mỗi cấp."

msgid "Trusted for longer routes with company tractor and trailer support."
msgstr ""
"Được tin tưởng giao các tuyến dài hơn với xe đầu kéo và rơ-moóc của hãng."

msgid "Heavy Freight Driver"
msgstr "Tài xế chở hàng nặng"

msgid ""
"Dispatch now lets you choose your own loads from the board, with more "
"machinery, construction, and bulk opportunities. The doubles endorsement "
"course opens under Licenses and training."
msgstr ""
"Điều phối giờ cho phép bạn tự chọn đơn hàng trên bảng đơn hàng, thêm nhiều "
"chuyến máy móc, vật liệu xây dựng và hàng rời. Khóa học hạng bổ sung CDL "
"rơ-moóc đôi đã mở trong mục Giấy phép và đào tạo."

msgid ""
"Trusted with heavier freight while the carrier covers operating costs."
msgstr ""
"Được giao các lô hàng nặng hơn trong khi hãng lo toàn bộ chi phí vận hành."

msgid "High-Value Company Driver"
msgstr "Tài xế hãng chở hàng giá trị cao"

msgid ""
"Dispatch assigns you one long-haul sleeper tractor that you drive on every "
"load, with priority access to fragile and high-value lanes."
msgstr ""
"Điều phối giao cố định cho bạn một xe đầu kéo đường dài có giường nằm để "
"chạy mọi chuyến, cùng quyền ưu tiên nhận các tuyến hàng dễ vỡ và giá trị "
"cao."

msgid "Dispatch trusts the driver with higher-consequence freight."
msgstr "Điều phối tin tưởng giao những lô hàng đòi hỏi trách nhiệm cao hơn."

msgid "Lead Company Driver"
msgstr "Tài xế hãng chủ lực"

msgid ""
"Senior company-driver status, the dispatch board grows to seven offers per "
"visit, and the hazmat endorsement course opens under Licenses and training."
msgstr ""
"Đạt vị thế tài xế hãng kỳ cựu, bảng đơn hàng tăng lên bảy chuyến đề xuất "
"mỗi lần xem và khóa học hạng bổ sung CDL hàng nguy hiểm đã mở trong mục "
"Giấy phép và đào tạo."

msgid ""
"A veteran company driver, still protected from tractor operating costs."
msgstr ""
"Tài xế hãng dày dạn kinh nghiệm, vẫn không phải gánh chi phí vận hành xe "
"đầu kéo."

msgid "Specialized Company Driver"
msgstr "Tài xế hãng hàng chuyên dụng"

msgid "Senior company driver"
msgstr "Tài xế hãng kỳ cựu"

msgid "Specialized freight now appears more often on your board."
msgstr ""
"Hàng chuyên dụng giờ xuất hiện thường xuyên hơn trên bảng đơn hàng của bạn."

msgid "Credentials and careful service matter more to dispatch."
msgstr ""
"Giấy phép và chứng chỉ cùng phong cách phục vụ cẩn trọng ngày càng có trọng "
"lượng với điều phối."

msgid "Premium Lane Driver"
msgstr "Tài xế tuyến hàng cao cấp"

msgid "The board grows to eight offers and favors premium long-haul lanes."
msgstr ""
"Bảng đơn hàng tăng lên tám chuyến đề xuất và ưu tiên các tuyến đường dài "
"cước cao."

msgid "Trusted for premium company freight without personal equipment risk."
msgstr ""
"Được tin tưởng chạy hàng cao cấp của hãng mà không phải gánh rủi ro thiết "
"bị cá nhân."

msgid "Carrier Mentor Driver"
msgstr "Tài xế hướng dẫn của hãng"

msgid "Dispatch upgrades your assigned tractor to a premium fleet unit."
msgstr ""
"Điều phối nâng cấp xe được hãng giao của bạn lên một chiếc thuộc đội xe cao "
"cấp."

msgid "A senior company driver with reliable service history."
msgstr "Tài xế hãng kỳ cựu có lịch sử giao hàng đáng tin cậy."

msgid "Business Prep Driver"
msgstr "Tài xế chuẩn bị ra riêng"

msgid "Business status now reads the full owner-operator checklist."
msgstr ""
"Mục Tình trạng kinh doanh giờ hiển thị đầy đủ danh sách điều kiện lên tài "
"xế chủ xe."

msgid "Learning reserves and settlement risk while still on company wages."
msgstr ""
"Tìm hiểu về các quỹ dự phòng và rủi ro quyết toán chuyến khi vẫn đang hưởng "
"lương hãng."

msgid "Owner-Operator Candidate"
msgstr "Ứng viên tài xế chủ xe"

msgid "Business preparation"
msgstr "Chuẩn bị làm chủ xe"

msgid "Your savings target is now shown."
msgstr "Mục tiêu tiền tiết kiệm của bạn giờ đã được hiển thị."

msgid ""
"Saving for the owner-operator buy-in instead of a lease-purchase deal."
msgstr ""
"Tích lũy tiền cho khoản mua đứt xe lên tài xế chủ xe thay vì ký hợp đồng "
"thuê mua qua hãng."

msgid "Leased-On Applicant"
msgstr "Ứng viên chủ xe hợp đồng cho hãng"

msgid "Owner-operator preparation"
msgstr "Chuẩn bị lên tài xế chủ xe"

msgid "Every owner-operator buy-in requirement appears in full."
msgstr "Mọi điều kiện mua xe lên tài xế chủ xe đều đã hiển thị đầy đủ."

msgid "Finishing the delivery, reputation, and cash requirements."
msgstr "Hoàn tất các chỉ tiêu về số chuyến giao, uy tín và vốn tiền mặt."

msgid "Tractor Buy-In Candidate"
msgstr "Ứng viên mua đứt xe đầu kéo"

msgid ""
"First pick of the yard: dispatch assigns the carrier's best tractor, and "
"the buy-in target is active."
msgstr ""
"Ưu tiên chọn xe tốt nhất bãi: điều phối giao cho bạn chiếc đầu kéo xịn nhất "
"của hãng, và mục tiêu mua xe đã kích hoạt."

msgid "Close to the owner-operator buy-in, but still on company wages."
msgstr ""
"Đã rất gần bước mua xe lên tài xế chủ xe, nhưng hiện vẫn ăn lương hãng."

msgid "Leased-On Owner-Operator"
msgstr "Chủ xe hợp đồng cho hãng"

msgid "Owner-operator"
msgstr "Tài xế chủ xe"

msgid ""
"The owner-operator buy-in opens once its other requirements are met: you "
"buy the truck you drive and haul for the carrier as a leased-on "
"owner-operator. TWIC port card enrollment opens under Licenses and training."
msgstr ""
"Bước mua xe chuyển sang tài xế chủ xe sẽ mở khi đáp ứng đủ các điều kiện "
"còn lại: bạn mua lại chiếc xe mình đang lái và kéo hàng cho hãng với tư "
"cách chủ xe hợp đồng cho hãng. Mục đăng ký thẻ cảng TWIC cũng đã mở trong "
"Giấy phép và đào tạo."

msgid "Eligible to buy your own truck and pay its operating costs."
msgstr "Đủ điều kiện mua xe đầu kéo riêng và tự chi trả chi phí vận hành."

msgid "Settled Owner-Operator"
msgstr "Tài xế chủ xe ổn định"

msgid "Owner-operator settlements are now routine."
msgstr "Quyết toán chuyến kiểu tài xế chủ xe giờ đã vào guồng."

msgid ""
"Learning fuel, maintenance, insurance, trailer, and settlement reserves."
msgstr ""
"Làm quen cách cân đối tiền dầu, bảo dưỡng, bảo hiểm, rơ-moóc và phí quyết "
"toán."

msgid "Established Owner-Operator"
msgstr "Tài xế chủ xe vững tay"

msgid ""
"Specialty trailer programs matter more, and LCV training opens for "
"doubles-endorsed drivers with a clean recent record."
msgstr ""
"Các gói thuê rơ-moóc chuyên dụng ngày càng quan trọng, và khóa đào tạo LCV "
"đã mở cho tài xế có hạng bổ sung rơ-moóc đôi cùng hồ sơ gần đây sạch sẽ."

msgid ""
"Running as a steady leased-on business with clearer upside and costs."
msgstr ""
"Vận hành ổn định như một chủ xe hợp đồng cho hãng, nắm rõ cả lợi nhuận lẫn "
"chi phí."

msgid "Authority Prep Candidate"
msgstr "Ứng viên chuẩn bị giấy phép vận tải riêng"

msgid "Authority preparation"
msgstr "Chuẩn bị giấy phép vận tải riêng"

msgid ""
"Authority prep reserve can unlock when the other requirements are met."
msgstr ""
"Quỹ chuẩn bị giấy phép vận tải riêng có thể mở khóa khi các điều kiện khác "
"đã đạt."

msgid ""
"Studying full authority while staying focused on one-truck operations."
msgstr ""
"Tìm hiểu quy trình xin giấy phép vận tải riêng trong khi vẫn tập trung vận "
"hành một xe."

msgid "Direct Freight Prep"
msgstr "Chuẩn bị nhận hàng trực tiếp"

msgid "The steps to direct freight are now listed."
msgstr "Các bước tiến tới nhận hàng trực tiếp giờ đã được liệt kê."

msgid ""
"Building reputation and working capital before direct broker freight."
msgstr ""
"Tích lũy uy tín và vốn lưu động trước khi nhận hàng trực tiếp qua môi giới."

msgid "Trailer Strategy Owner"
msgstr "Chủ xe hoạch định rơ-moóc"

msgid "Trailer ownership planning matters for direct freight."
msgstr ""
"Việc tính toán sở hữu rơ-moóc riêng trở nên quan trọng khi chạy hàng trực "
"tiếp."

msgid "Choosing when a trailer program is enough and when ownership helps."
msgstr ""
"Cân nhắc khi nào gói thuê rơ-moóc là đủ và khi nào mua rơ-moóc riêng sẽ có "
"lợi hơn."

msgid "Authority-Ready Operator"
msgstr "Chủ xe sẵn sàng lên giấy phép riêng"

msgid "Final authority activation checklist."
msgstr "Danh sách kiểm tra cuối cùng để kích hoạt giấy phép vận tải riêng."

msgid "Getting ready to run under your own authority."
msgstr "Chuẩn bị chạy hàng dưới giấy phép vận tải riêng của chính bạn."

msgid "Independent Authority Operator"
msgstr "Chủ xe có giấy phép vận tải riêng"

msgid "Own authority"
msgstr "Giấy phép vận tải riêng"

msgid ""
"Own authority and direct freight unlock when the other requirements are met."
msgstr ""
"Giấy phép vận tải riêng và hàng trực tiếp sẽ mở khóa khi các điều kiện khác "
"đã đạt."

msgid ""
"Direct freight is available, with insurance, compliance and billing fees."
msgstr ""
"Đã có thể nhận hàng trực tiếp, đi kèm phí bảo hiểm, tuân thủ pháp lý và phí "
"thanh toán."

msgid "Contract Freight Builder"
msgstr "Chủ xe xây dựng hàng hợp đồng"

msgid "Established owner-operator"
msgstr "Tài xế chủ xe vững tay"

msgid "Premium direct freight reputation matters more."
msgstr "Uy tín khi chạy hàng trực tiếp cao cấp ngày càng quan trọng."

msgid "Building repeat customers for your one truck."
msgstr "Xây dựng tệp khách hàng quen cho chiếc xe của bạn."

msgid "Specialized Trailer Operator"
msgstr "Chủ xe rơ-moóc chuyên dụng"

msgid "Specialized trailer opportunities stand out."
msgstr "Các cơ hội hàng cần rơ-moóc chuyên dụng nổi bật hơn hẳn."

msgid "Matching owned or leased equipment to better freight."
msgstr ""
"Ghép đúng rơ-moóc tự sở hữu hoặc thuê theo gói với những lô hàng cước tốt "
"hơn."

msgid "Premium Lane Operator"
msgstr "Chủ xe tuyến hàng cao cấp"

msgid "Premium lanes favor high reputation and the right trailer."
msgstr "Các tuyến hàng cao cấp ưu tiên uy tín cao và đúng loại rơ-moóc."

msgid "An established owner-operator with strong freight-market choice."
msgstr ""
"Một tài xế chủ xe vững tay với nhiều quyền lựa chọn trên thị trường hàng "
"hóa."

msgid "Veteran Independent Operator"
msgstr "Chủ xe độc lập kỳ cựu"

msgid "Prestige freight and best dispatch quality."
msgstr "Hàng hóa hạng sang và chất lượng điều phối tốt nhất."

msgid "A proven independent driver, not a fleet manager."
msgstr ""
"Một tài xế độc lập đã khẳng định năng lực, chứ không phải người quản lý đội "
"xe."

msgid "Freight Fate Independent"
msgstr "Chủ xe độc lập Freight Fate"

msgid "Top career rank."
msgstr "Cấp bậc cao nhất trong sự nghiệp."

msgid "A complete company-driver to independent owner-operator career."
msgstr ""
"Một hành trình sự nghiệp trọn vẹn từ tài xế hãng đến tài xế chủ xe độc lập."

msgid "Dedicated Company Driver"
msgstr "Tài xế hãng gắn bó"

msgid "Career company driver"
msgstr "Tài xế hãng chuyên nghiệp"

msgid ""
"Senior company lanes stay open without the owner-operator prep track."
msgstr ""
"Các tuyến tài xế hãng kỳ cựu vẫn mở rộng mà không cần đi theo lộ trình "
"chuẩn bị lên chủ xe."

msgid ""
"Choosing carrier equipment as a long-term career, not a waiting room."
msgstr ""
"Chọn chạy xe của hãng làm sự nghiệp lâu dài chứ không chỉ là bước đệm."

msgid "Fleet Senior Driver"
msgstr "Tài xế kỳ cựu đội xe"

msgid "Dispatch favors you with steadier premium freight on company trucks."
msgstr ""
"Điều phối ưu ái giao cho bạn các chuyến hàng cao cấp ổn định hơn trên xe "
"của hãng."

msgid "A senior company driver with a settled place on the fleet."
msgstr "Một tài xế hãng kỳ cựu có vị thế vững vàng trong đội xe."

msgid "Lead Fleet Driver"
msgstr "Tài xế đầu tàu đội xe"

msgid ""
"First pick of the yard: dispatch assigns the carrier's best tractor for a "
"company driver who stayed on the payroll."
msgstr ""
"Ưu tiên chọn xe tốt nhất bãi: điều phối giao chiếc đầu kéo xịn nhất của "
"hãng cho tài xế gắn bó ăn lương hãng."

msgid ""
"Top of the assigned-fleet ladder while the carrier still owns the risk."
msgstr ""
"Đỉnh cao của nhánh chạy xe hãng giao trong khi hãng vẫn gánh rủi ro."

msgid "Company Fleet Captain"
msgstr "Tài xế nòng cốt đội xe hãng"

msgid "Top fleet standing: first pick of company freight."
msgstr "Vị thế hàng đầu đội xe: được chọn trước các đơn hàng của hãng."

msgid "A career company driver at the buy-in fork who kept the safer seat."
msgstr ""
"Tài xế hãng gắn bó đứng trước ngã rẽ mua xe nhưng đã chọn giữ ghế lái an "
"toàn."

msgid "Veteran Company Hauler"
msgstr "Tài xế hãng đường dài lão luyện"

msgid "Long-haul company work becomes the normal rhythm."
msgstr "Chạy đường dài cho hãng trở thành nhịp làm việc quen thuộc."

msgid "Miles and reputation keep growing on carrier equipment."
msgstr "Số dặm chạy và uy tín tiếp tục tăng trên xe của hãng."

msgid "Senior Fleet Regular"
msgstr "Tài xế kỳ cựu quen tuyến"

msgid "Specialty company freight and clean-service bonuses matter more."
msgstr ""
"Hàng chuyên dụng của hãng và tiền thưởng chạy sạch, đúng giờ ngày càng có "
"giá trị."

msgid ""
"A dependable senior company driver with nothing left to prove on risk."
msgstr ""
"Tài xế hãng kỳ cựu đáng tin cậy, không cần mạo hiểm tự gánh rủi ro thiết bị."

msgid "Carrier Elite Driver"
msgstr "Tài xế tinh nhuệ của hãng"

msgid "Elite company driver"
msgstr "Tài xế hãng tinh nhuệ"

msgid "Elite company standing opens the strongest carrier lanes."
msgstr ""
"Vị thế tinh nhuệ tại hãng mở ra những tuyến hàng tốt nhất của công ty."

msgid "Running the freight the carrier trusts only its best drivers with."
msgstr ""
"Chuyên chở những lô hàng mà hãng chỉ dám giao cho các tài xế giỏi nhất."

msgid "Premium Company Lane Driver"
msgstr "Tài xế hãng tuyến cao cấp"

msgid "Premium company lanes favor high reputation and clean timing."
msgstr ""
"Các tuyến cao cấp của hãng ưu tiên uy tín cao và giờ giấc chuẩn xác."

msgid ""
"An elite company driver with first call on the most valuable freight."
msgstr ""
"Tài xế hãng tinh nhuệ được gọi đầu tiên cho những lô hàng giá trị nhất."

msgid "Master Company Driver"
msgstr "Tài xế hãng bậc thầy"

msgid ""
"Master company status: mentoring weight and priority board placement."
msgstr ""
"Vị thế tài xế hãng bậc thầy: có tiếng nói cố vấn và được ưu tiên trên bảng "
"đơn hàng."

msgid ""
"Credentials, service, and seniority carry equal weight with dispatch."
msgstr ""
"Giấy phép và chứng chỉ, chất lượng phục vụ và thâm niên đều có trọng lượng "
"ngang nhau với điều phối."

msgid "Distinguished Fleet Driver"
msgstr "Tài xế xuất sắc của đội xe"

msgid "Distinguished fleet standing across the carrier's best lanes."
msgstr "Vị thế xuất sắc trong đội xe trên những tuyến tốt nhất của hãng."

msgid "A distinguished company driver still protected from equipment risk."
msgstr "Tài xế hãng xuất sắc nhưng vẫn được che chắn khỏi rủi ro thiết bị."

msgid "Senior Fleet Mentor"
msgstr "Cố vấn kỳ cựu đội xe"

msgid "Lifetime company driver"
msgstr "Tài xế hãng trọn đời"

msgid "Senior mentoring status: the carrier leans on your judgment."
msgstr ""
"Vai trò cố vấn kỳ cựu: hãng tin cậy vào kinh nghiệm phán đoán của bạn."

msgid "Teaching by example while still driving company freight."
msgstr "Làm gương cho lớp sau trong khi vẫn trực tiếp chở hàng của hãng."

msgid "Carrier Lifetime Driver"
msgstr "Tài xế trọn đời của hãng"

msgid "Lifetime company standing with the strongest repeat lanes."
msgstr "Vị thế gắn bó trọn đời với những tuyến hàng quen tốt nhất của hãng."

msgid "A career measured in clean company miles, not ownership."
msgstr ""
"Sự nghiệp đo bằng những dặm đường an toàn cho hãng, không cần đứng tên sở "
"hữu xe."

msgid "Elite Specialized Company Driver"
msgstr "Tài xế hãng hàng chuyên dụng tinh nhuệ"

msgid "Specialized company freight stands out on your board."
msgstr "Hàng chuyên dụng của hãng nổi bật hẳn trên bảng đơn hàng của bạn."

msgid "Matching credentials to the carrier's hardest work."
msgstr ""
"Kết hợp đúng giấy phép và chứng chỉ cho những chuyến hàng khó nhất của hãng."

msgid "Top-Seniority Company Driver"
msgstr "Tài xế hãng thâm niên hàng đầu"

msgid "Top-seniority company placement on prestige carrier lanes."
msgstr "Vị trí thâm niên cao nhất của hãng trên các tuyến hàng danh giá."

msgid "Nothing on the board is above your standing."
msgstr "Không đơn hàng nào trên bảng vượt quá tầm vị thế của bạn."

msgid "Company Career Veteran"
msgstr "Lão tướng sự nghiệp tài xế hãng"

msgid "Prestige company freight and best dispatch quality."
msgstr "Hàng danh giá của hãng và chất lượng điều phối tốt nhất."

msgid "A proven company driver at the top of the carrier ladder."
msgstr "Tài xế hãng đã khẳng định bản lĩnh ở đỉnh cao nấc thang công ty."

msgid "Freight Fate Company Driver"
msgstr "Tài xế hãng Freight Fate"

msgid "Top company-driver career rank."
msgstr "Cấp bậc cao nhất của nhánh tài xế hãng."

msgid ""
"A complete company-driver career without taking the owner-operator seat."
msgstr ""
"Một sự nghiệp tài xế hãng trọn vẹn mà không cần bước sang ghế tài xế chủ xe."


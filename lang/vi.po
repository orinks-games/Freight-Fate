"Plural-Forms: nplurals=1; plural=0;\n"
"X-Language-Name: Vietnamese\n"

msgid "A Secret the Manifest Is Keeping"
msgstr "Bí mật giấu trong phiếu hàng"

msgid "Some badges stay secret until you earn them. Keep driving."
msgstr ""
"Một số huy hiệu sẽ giữ bí mật cho tới khi bạn đạt được. Cứ tiếp tục cầm lái "
"nhé."

msgid "road"
msgstr ""

msgid "Out on the Road"
msgstr "Ngoài xa lộ"

msgid "Clean runs, hard climbs, and the everyday work of hauling freight."
msgstr ""
"Những chuyến chạy suôn sẻ, những con dốc gắt và nhịp mưu sinh thường ngày "
"của nghề chở hàng."

msgid "The Working Day"
msgstr "Một ngày cầm lái"

msgid ""
"Rest breaks, inspections, traffic, and the rules that keep a driver legal."
msgstr ""
"Nghỉ giữa ca, kiểm tra an toàn, xe cộ và những quy tắc giữ bạn chạy đúng "
"luật."

msgid "career"
msgstr ""

msgid "Career and Rank"
msgstr "Sự nghiệp và cấp bậc"

msgid "Levels, money and trucks, from new hire to owner-operator."
msgstr ""
"Cấp độ, tiền bạc và xe đầu kéo, từ người mới vào nghề đến tài xế chủ xe."

msgid "The Dial and Song Towns"
msgstr "Sóng đài và phố nhạc"

msgid ""
"Stations you catch on the dial, and the towns those songs put on the map."
msgstr ""
"Những đài phát thanh bắt được trên sóng và những thị trấn bước ra từ lời ca "
"trên bản đồ."

msgid "Weather and the Calendar"
msgstr "Thời tiết và bốn mùa"

msgid "Rain, snow, fog, and the seasons while you kept driving."
msgstr ""
"Mưa gió, tuyết rơi, sương mù và vòng xoay bốn mùa qua ô kính chắn gió."

msgid "places"
msgstr ""

msgid "Places on the Map"
msgstr "Những vùng đất đã qua"

msgid "Cities, states, and regions you hauled into."
msgstr "Những thành phố, bang và vùng miền bạn từng đưa hàng tới."

msgid "hidden"
msgstr ""

msgid "Deep Cuts"
msgstr "Góc khuất nghề tài"

msgid "A few badges even dispatch doesn't see coming."
msgstr "Vài huy hiệu mà ngay cả điều phối cũng chẳng ngờ tới."

msgid "Breaker, Breaker"
msgstr "A lô, xin lên kênh"

msgid ""
"Your first load off the dispatch board. You have a load number and "
"somewhere to be."
msgstr ""
"Lô hàng đầu tiên nhận từ bảng đơn hàng. Bạn đã có mã lô hàng và đích đến "
"phía trước."

msgid "C.W. McCall - Convoy"
msgstr "C.W. McCall - Convoy"

msgid "Roll On"
msgstr "Lăn bánh lên đường"

msgid "Your first load is on the trailer and sealed."
msgstr "Lô hàng đầu tiên đã lên rơ-moóc và kẹp chì xong xuôi."

msgid "Alabama - Roll On (Eighteen Wheeler)"
msgstr "Alabama - Roll On (Eighteen Wheeler)"

msgid "First Day"
msgstr "Ngày đầu cầm lái"

msgid "Your first load, picked up and sealed. Day one is under way."
msgstr ""
"Lô hàng đầu tiên đã bốc lên xe và kẹp chì. Ngày đầu tiên chính thức bắt đầu."

msgid "The Franklin County Trucking Company - I'm a Trucker"
msgstr "The Franklin County Trucking Company - I'm a Trucker"

msgid "Truck Driving Man"
msgstr "Tay lái xe tải thứ thiệt"

msgid "Your first load, delivered and signed for."
msgstr "Lô hàng đầu tiên đã giao tận nơi và có chữ ký nhận."

msgid "Terry Fell - Truck Drivin' Man"
msgstr "Terry Fell - Truck Drivin' Man"

msgid "Six Days, Right on Time"
msgstr "Sáu ngày chạy, đúng giờ hẹn"

msgid "A delivery before the deadline."
msgstr "Giao một chuyến hàng trước hạn giao hàng."

msgid "Dave Dudley - Six Days on the Road"
msgstr "Dave Dudley - Six Days on the Road"

msgid "Pretty as a Billboard"
msgstr "Đẹp như hình quảng cáo"

msgid ""
"A delivery with almost no new damage. The truck is still pretty enough for "
"a billboard."
msgstr ""
"Giao hàng xong hầu như không thêm hư hại mới nào. Chiếc xe vẫn đẹp đủ để "
"lên biển quảng cáo."

msgid "Del Reeves - Girl on the Billboard"
msgstr "Del Reeves - Girl on the Billboard"

msgid "Nothing for the Highway Patrol"
msgstr "Cảnh sát tuần tra chẳng bắt được lỗi gì"

msgid "A whole run without a speeding ticket."
msgstr "Trọn một chuyến chạy không dính biên bản phạt quá tốc độ."

msgid "Junior Brown - Highway Patrol"
msgstr "Junior Brown - Highway Patrol"

msgid "On the Road Again"
msgstr "Lại lên đường thôi"

msgid "Five deliveries. You already can't wait for the next one."
msgstr "Năm chuyến giao hàng. Bạn đã nóng lòng chờ chuyến tiếp theo rồi."

msgid "Willie Nelson - On the Road Again"
msgstr "Willie Nelson - On the Road Again"

msgid "What a Long, Strange Haul"
msgstr "Chuyến hàng dài đầy chuyện lạ"

msgid "Ten deliveries. The stories are starting to pile up."
msgstr "Mười chuyến giao hàng. Chuyện nghề bắt đầu chất đầy rồi đấy."

msgid "Grateful Dead - Truckin'"
msgstr "Grateful Dead - Truckin'"

msgid "Turn the Page"
msgstr "Lật sang trang mới"

msgid "Career level 3. Another town, and this one pays better."
msgstr ""
"Cấp bậc sự nghiệp 3. Lại một thị trấn khác, và chỗ này trả công hậu hơn."

msgid "Bob Seger - Turn the Page"
msgstr "Bob Seger - Turn the Page"

msgid "One Load at a Time"
msgstr "Tích góp từng chuyến một"

msgid "25,000 dollars banked, one load at a time."
msgstr "Tích góp được 25.000 đô la vào tài khoản, từng chuyến hàng một."

msgid "Johnny Cash - One Piece at a Time"
msgstr "Johnny Cash - One Piece at a Time"

msgid "White Line Fever"
msgstr "Cơn mê vạch kẻ đường"

msgid "A thousand miles driven. You have caught it now."
msgstr ""
"Một nghìn dặm đường đã chạy. Giờ thì bạn đã nhiễm cơn mê đường dài rồi."

msgid "Merle Haggard - White Line Fever"
msgstr "Merle Haggard - White Line Fever"

msgid "Life Is a Highway"
msgstr "Cuộc đời là một xa lộ"

msgid "One loaded haul of more than 900 miles."
msgstr "Một chuyến chở hàng dài hơn 900 dặm."

msgid "Tom Cochrane - Life Is a Highway"
msgstr "Tom Cochrane - Life Is a Highway"

msgid "Promised Land"
msgstr "Miền đất hứa"

msgid "Your first state line with freight aboard."
msgstr "Lần đầu vượt ranh giới bang khi trên xe đang có hàng."

msgid "Chuck Berry - Promised Land"
msgstr "Chuck Berry - Promised Land"

msgid "Hard Traveling"
msgstr "Dặm đường gian nan"

msgid "Three states on one route."
msgstr "Đi qua ba bang trên cùng một tuyến."

msgid "Dick Curless - Hard, Hard Traveling Man"
msgstr "Dick Curless - Hard, Hard Traveling Man"

msgid "Wherever You May Roam"
msgstr "Dù bạn rong ruổi phương nào"

msgid "You have worked in three freight regions."
msgstr "Bạn đã chạy hàng ở ba vùng vận tải khác nhau."

msgid "Metallica - Wherever I May Roam"
msgstr "Metallica - Wherever I May Roam"

msgid "A Dime at a Time"
msgstr "Từng đồng xu qua trạm"

msgid "Your first toll, paid."
msgstr "Đã trả khoản phí cầu đường đầu tiên."

msgid "Del Reeves - A Dime at a Time"
msgstr "Del Reeves - A Dime at a Time"

msgid "Free Ride"
msgstr "Chuyến đi miễn phí"

msgid "Over 300 loaded miles without a toll."
msgstr "Hơn 300 dặm chở hàng không mất đồng phí cầu đường nào."

msgid "The Edgar Winter Group - Free Ride"
msgstr "The Edgar Winter Group - Free Ride"

msgid "Who'll Stop the Rain"
msgstr "Ai ngăn được cơn mưa"

msgid "You drove through rain."
msgstr "Bạn đã lái xe xuyên mưa."

msgid "Creedence Clearwater Revival - Who'll Stop the Rain"
msgstr "Creedence Clearwater Revival - Who'll Stop the Rain"

msgid "Four Strong Winds"
msgstr "Bốn phương gió lớn"

msgid "You drove through snow, ice or a strong wind."
msgstr "Bạn đã lái xe qua tuyết, băng giá hoặc gió mạnh."

msgid "Ian & Sylvia - Four Strong Winds"
msgstr "Ian & Sylvia - Four Strong Winds"

msgid "Foggy Mountain Haul"
msgstr "Xuyên mù vượt núi"

msgid "You drove through thick fog or a thunderstorm."
msgstr "Bạn đã lái xe xuyên qua sương mù dày hoặc cơn giông bão."

msgid "Flatt & Scruggs - Foggy Mountain Breakdown"
msgstr "Flatt & Scruggs - Foggy Mountain Breakdown"

msgid "Diesel Smoke, Dangerous Road"
msgstr "Khói dầu diesel, đường đầy hiểm nguy"

msgid "You got clear of a road hazard."
msgstr "Bạn đã vượt qua an toàn một chướng ngại vật trên đường."

msgid "Doye O'Dell - Diesel Smoke, Dangerous Curves"
msgstr "Doye O'Dell - Diesel Smoke, Dangerous Curves"

msgid "Forty Miles of Bad Road"
msgstr "Bốn mươi dặm đường xấu"

msgid "You drove into a work zone."
msgstr "Bạn đã chạy vào khu vực thi công."

msgid "Duane Eddy - Forty Miles of Bad Road"
msgstr "Duane Eddy - Forty Miles of Bad Road"

msgid "Traffic Jam"
msgstr "Kẹt xe nối đuôi"

msgid "You ran into heavy traffic."
msgstr "Bạn đã chạy vào đoạn xe cộ xung quanh ùn tắc."

msgid "James Taylor - Traffic Jam"
msgstr "James Taylor - Traffic Jam"

msgid "inspection"
msgstr ""

msgid "Smokey at the Scale"
msgstr "Cảnh sát ở trạm cân"

msgid "An inspection passed, with your paperwork and axle weights in order."
msgstr ""
"Vượt qua một lượt kiểm tra an toàn lưu động với giấy tờ đầy đủ và tải trọng "
"trục xe đạt chuẩn."

msgid "Rod Hart - C.B. Savage"
msgstr "Rod Hart - C.B. Savage"

msgid "Truck Stop Sweetheart"
msgstr "Người thương ở trạm dừng"

msgid "Your first rest stop. The vending machine was glad of the company."
msgstr ""
"Lần ghé trạm nghỉ đầu tiên. Cái máy bán hàng tự động chắc mừng vì có bạn "
"bầu bạn."

msgid "The Willis Brothers - Truck Stop Cutie"
msgstr "The Willis Brothers - Truck Stop Cutie"

msgid "Keep On Truckin'"
msgstr "Cứ thế mà chạy tiếp"

msgid "Your first fill-up, at a terminal or on the road."
msgstr "Lần đổ dầu đầu tiên, tại trạm chính hoặc dọc đường."

msgid "Eddie Kendricks - Keep On Truckin'"
msgstr "Eddie Kendricks - Keep On Truckin'"

msgid "Coffee Break, Driver"
msgstr "Nghỉ tay làm ly cà phê, tài ơi"

msgid "Your first 30-minute break, taken."
msgstr "Đã hoàn thành giờ nghỉ 30 phút đầu tiên."

msgid "Ramblin' Jack Elliott - A Cup of Coffee"
msgstr "Ramblin' Jack Elliott - A Cup of Coffee"

msgid "Five-by-Two"
msgstr "Khoang ngủ nhỏ gọn"

msgid "Ten hours in the sleeper, and you're good for another eleven."
msgstr ""

msgid "Red Simpson - Sleeper, Five-By-Two"
msgstr "Red Simpson - Sleeper, Five-By-Two"

msgid "Mama Warned You"
msgstr "Lời mẹ đã dặn"

msgid "You went to bed before fatigue took the wheel."
msgstr "Bạn đi ngủ trước khi cơn buồn ngủ cướp mất tay lái."

msgid "Commander Cody and His Lost Planet Airmen - Mama Hated Diesels"
msgstr "Commander Cody and His Lost Planet Airmen - Mama Hated Diesels"

msgid "Handy Man"
msgstr "Tay thợ lành nghề"

msgid "A repair done at a garage. The truck earns its keep again."
msgstr "Sửa xong xe tại xưởng. Chiếc xe tải lại tiếp tục kiếm cơm."

msgid "Jimmy Jones - Handy Man"
msgstr "Jimmy Jones - Handy Man"

msgid "Souped Up"
msgstr "Độ xe bốc máy"

msgid "Your first truck upgrade."
msgstr "Lần nâng cấp xe đầu kéo đầu tiên."

msgid "Charlie Ryan - Hot Rod Lincoln"
msgstr "Charlie Ryan - Hot Rod Lincoln"

msgid "Big Wheel Cannonball"
msgstr "Chiến mã bánh lớn"

msgid ""
"You bought the heavy hauler. The hills are nervous, and so is the fuel bill."
msgstr ""
"Bạn đã tậu chiếc đầu kéo hạng nặng. Những con dốc bắt đầu dè chừng, còn hóa "
"đơn tiền dầu cũng phát hoảng."

msgid "Dick Curless - Big Wheel Cannonball"
msgstr "Dick Curless - Big Wheel Cannonball"

msgid "Under Pressure"
msgstr "Đủ áp suất hơi"

msgid "You built full air before releasing the parking brake."
msgstr "Bạn đã bơm đầy hơi trước khi nhả phanh đỗ."

msgid "Queen & David Bowie - Under Pressure"
msgstr "Queen & David Bowie - Under Pressure"

msgid "Gear Shifting"
msgstr "Tay côn cần số"

msgid "You drove a run with the manual transmission."
msgstr "Bạn đã chạy một chuyến bằng hộp số sàn."

msgid "Pete Drake - Gear Shiftin'"
msgstr "Pete Drake - Gear Shiftin'"

msgid "East Bound and Down"
msgstr "Thẳng tiến hướng đông"

msgid "A load hauled east and delivered."
msgstr "Một lô hàng kéo về hướng đông và đã giao xong."

msgid "Jerry Reed - East Bound and Down"
msgstr "Jerry Reed - East Bound and Down"

msgid "West Bound and Down"
msgstr "Thẳng tiến hướng tây"

msgid "A load hauled west and delivered."
msgstr "Một lô hàng kéo về hướng tây và đã giao xong."

msgid "Jerry Reed - West Bound and Down"
msgstr "Jerry Reed - West Bound and Down"

msgid "Kicks on 66"
msgstr "Hứng khởi trên Route 66"

msgid "A haul between two old Route 66 towns."
msgstr "Một chuyến hàng nối hai thị trấn cổ dọc Route 66."

msgid "Bobby Troup - (Get Your Kicks on) Route 66"
msgstr "Bobby Troup - (Get Your Kicks on) Route 66"

msgid "Amarillo by Morning"
msgstr "Tới Amarillo lúc sáng sớm"

msgid "A load delivered in Amarillo in the morning."
msgstr "Giao một lô hàng tại Amarillo vào buổi sáng."

msgid "George Strait - Amarillo by Morning"
msgstr "George Strait - Amarillo by Morning"

msgid "By the Time You Got to Phoenix"
msgstr "Khi bạn tới được Phoenix"

msgid "A load delivered in Phoenix. The desert never did cool off."
msgstr "Giao một lô hàng tại Phoenix. Sa mạc chưa bao giờ chịu dịu mát."

msgid "Glen Campbell - By the Time I Get to Phoenix"
msgstr "Glen Campbell - By the Time I Get to Phoenix"

msgid "Wichita, On the Line"
msgstr "Wichita, trên đường dây"

msgid "A load delivered in Wichita. A lineman waved."
msgstr ""
"Giao một lô hàng tại Wichita. Một người thợ đường dây đã vẫy tay chào."

msgid "Glen Campbell - Wichita Lineman"
msgstr "Glen Campbell - Wichita Lineman"

msgid "Lubbock in the Rearview"
msgstr "Lubbock lùi lại trong gương chiếu hậu"

msgid "You left Lubbock with a load."
msgstr "Bạn đã rời Lubbock cùng một lô hàng."

msgid "Mac Davis - Texas in My Rear View Mirror"
msgstr "Mac Davis - Texas in My Rear View Mirror"

msgid "Streets of Bakersfield"
msgstr "Những con phố Bakersfield"

msgid "A load delivered in Bakersfield."
msgstr "Giao một lô hàng tại Bakersfield."

msgid "Dwight Yoakam & Buck Owens - Streets of Bakersfield"
msgstr "Dwight Yoakam & Buck Owens - Streets of Bakersfield"

msgid "Tulsa Time"
msgstr "Chuẩn giờ Tulsa"

msgid "A load delivered in Tulsa on time."
msgstr "Giao một lô hàng tại Tulsa đúng hạn."

msgid "Don Williams - Tulsa Time"
msgstr "Don Williams - Tulsa Time"

msgid "Viva Las Vegas"
msgstr "Las Vegas bất diệt"

msgid "A load delivered in Las Vegas. You gambled only on the merge."
msgstr ""
"Giao một lô hàng tại Las Vegas. Bạn chỉ đánh cược đúng mỗi cú nhập làn."

msgid "Elvis Presley - Viva Las Vegas"
msgstr "Elvis Presley - Viva Las Vegas"

msgid "Midnight Freight to Georgia"
msgstr "Chuyến hàng nửa đêm về Georgia"

msgid ""
"Freight into Georgia at night. No first-class ticket, only a sleeper and a "
"thermos."
msgstr ""
"Chở hàng vào Georgia lúc đêm xuống. Chẳng có vé hạng nhất, chỉ có khoang "
"ngủ và bình giữ nhiệt."

msgid "Gladys Knight & the Pips - Midnight Train to Georgia"
msgstr "Gladys Knight & the Pips - Midnight Train to Georgia"

msgid "Detroit Rock City"
msgstr "Thành phố Rock Detroit"

msgid "A load hauled out of Detroit."
msgstr "Kéo một lô hàng rời Detroit."

msgid "KISS - Detroit Rock City"
msgstr "KISS - Detroit Rock City"

msgid "Been Everywhere"
msgstr "Đi khắp mọi nơi rồi"

msgid "You have hauled in every region on the map."
msgstr "Bạn đã chở hàng qua mọi vùng trên bản đồ."

msgid "Hank Snow - I've Been Everywhere"
msgstr "Hank Snow - I've Been Everywhere"

msgid "Fantastic Voyage"
msgstr "Chuyến đi kỳ thú"

msgid "One run across most of the continent."
msgstr "Một chuyến chạy băng ngang gần trọn lục địa."

msgid "Coolio - Fantastic Voyage"
msgstr "Coolio - Fantastic Voyage"

msgid "Big Wheels Rolling"
msgstr "Bánh lớn lăn đều"

msgid "Fifty deliveries. The board knows your handle."
msgstr "Năm mươi chuyến giao hàng. Bảng đơn hàng đã quen biệt danh của bạn."

msgid "Dan Seals - Big Wheels in the Moonlight"
msgstr "Dan Seals - Big Wheels in the Moonlight"

msgid "Keep On Rolling"
msgstr "Cứ thế lăn bánh mãi"

msgid "A hundred deliveries."
msgstr "Một trăm chuyến giao hàng."

msgid "Lynyrd Skynyrd - Call Me the Breeze"
msgstr "Lynyrd Skynyrd - Call Me the Breeze"

msgid "Long White Line"
msgstr "Vạch trắng dài bất tận"

msgid "Ten thousand miles driven."
msgstr "Mười nghìn dặm đường đã chạy."

msgid "Sturgill Simpson - Long White Line"
msgstr "Sturgill Simpson - Long White Line"

msgid "Prisoner of the Highway"
msgstr "Tù nhân của xa lộ"

msgid "Fifty thousand miles driven. The road will not let you go."
msgstr ""
"Năm mươi nghìn dặm đường đã chạy. Con đường chẳng chịu buông tha bạn đâu."

msgid "Ronnie Milsap - Prisoner of the Highway"
msgstr "Ronnie Milsap - Prisoner of the Highway"

msgid "Money"
msgstr "Tiền bạc"

msgid "100,000 dollars banked."
msgstr "Tích lũy được 100.000 đô la vào tài khoản."

msgid "Pink Floyd - Money"
msgstr "Pink Floyd - Money"

msgid "Highwayman"
msgstr "Hảo hán xa lộ"

msgid "Career level 20."
msgstr "Cấp bậc sự nghiệp 20."

msgid "The Highwaymen - Highwayman"
msgstr "The Highwaymen - Highwayman"

msgid "Respect"
msgstr "Sự nể trọng"

msgid ""
"Your reputation reached the top. The channel knows your handle, and "
"dispatch takes your word."
msgstr ""
"Uy tín của bạn đã chạm đỉnh. Cả kênh bộ đàm đều biết biệt danh của bạn, còn "
"điều phối thì tin lời bạn nói."

msgid "Aretha Franklin - Respect"
msgstr "Aretha Franklin - Respect"

msgid "When You're Hot"
msgstr "Khi vận đỏ đang lên"

msgid ""
"Five deliveries in a row on time, with almost no damage and no tickets."
msgstr ""
"Năm chuyến giao hàng liên tiếp đúng hạn, hầu như không hư hại và không biên "
"bản phạt."

msgid "Jerry Reed - When You're Hot, You're Hot"
msgstr "Jerry Reed - When You're Hot, You're Hot"

msgid "No Easy Run"
msgstr "Chẳng có chuyến nào dễ"

msgid "Over 1,200 miles, on time and with almost no damage."
msgstr "Hơn 1.200 dặm, đúng hạn và hầu như không hư hại."

msgid "Dave Dudley - There Ain't No Easy Run"
msgstr "Dave Dudley - There Ain't No Easy Run"

msgid "Big Boss Pay"
msgstr "Thù lao cỡ ông trùm"

msgid "One load that paid over 4,000 dollars."
msgstr "Một lô hàng trả công hơn 4.000 đô la."

msgid "Jimmy Reed - Big Boss Man"
msgstr "Jimmy Reed - Big Boss Man"

msgid "Wolf Creek Pass"
msgstr "Đèo Wolf Creek Pass"

msgid "A mountain grade, and the freight came down with almost no damage."
msgstr "Vượt một con dốc núi, và hàng hóa xuống đèo hầu như không hư hại."

msgid "C.W. McCall - Wolf Creek Pass"
msgstr "C.W. McCall - Wolf Creek Pass"

msgid "Movin' On"
msgstr "Tiếp tục tiến bước"

msgid "One dispatch, four or more corridors, run end to end."
msgstr ""
"Một lệnh điều phối, bốn chặng đường trở lên, chạy thông suốt từ đầu tới "
"cuối."

msgid "Hank Snow - I'm Movin' On"
msgstr "Hank Snow - I'm Movin' On"

msgid "Russell County Line"
msgstr "Ranh giới hạt Russell"

msgid "A load delivered in Virginia."
msgstr "Giao một lô hàng tại Virginia."

msgid "49 Winchester - Russell County Line"
msgstr "49 Winchester - Russell County Line"

msgid "Birmingham, 8:30 AM"
msgstr "Birmingham, 8:30 sáng"

msgid "A load into Birmingham in the morning, before the coffee kicked in."
msgstr ""
"Chở một lô hàng vào Birmingham buổi sáng, trước khi cà phê kịp ngấm."

msgid "Andrea and Mud - Birmingham, AL 8:30AM"
msgstr "Andrea and Mud - Birmingham, AL 8:30AM"

msgid "Kentucky Blue"

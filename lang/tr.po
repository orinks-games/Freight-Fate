msgstr "dorse yan lambası yanmıyor"

msgid "trailer brake out of adjustment"
msgstr "dorse freni ayarsız"

msgid "worn trailer tire below tread depth"
msgstr "dorse lastiğinin diş derinliği yetersiz"


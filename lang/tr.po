msgstr "İki parmakla sola çevirme: motoru durdur."

msgid "Second finger, hold left: steer left."
msgstr "İkinci parmak, sola tut: sola çevir."

msgid "Second finger, hold right: steer right."
msgstr "İkinci parmak, sağa tut: sağa çevir."


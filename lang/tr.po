msgstr "{gesture_name} artık şunu çalıştırıyor: {label}."

msgid "Swipe up and hold: gas. Lift to coast."
msgstr "Yukarı kaydırıp tutun: gaz. Kaldırınca boşta gider."

msgid "Swipe down and hold: brake."
msgstr "Aşağı kaydırıp tutun: fren."

msgid "Swipe left and hold: steer left."
msgstr "Sola kaydırıp tutun: sola çevir."

msgid "Swipe right and hold: steer right."
msgstr "Sağa kaydırıp tutun: sağa çevir."

msgid "Deep swipe down: emergency brake, or the parking brake when stopped."
msgstr "Derin aşağı kaydırma: acil fren, dururken el freni."

msgid "Hold still: straighten the wheel."
msgstr "Hareketsiz tutun: direksiyonu düzelt."

msgid "Emergency brake."

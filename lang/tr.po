msgid "Owed: {money_text}."
msgstr "Borç: {money_text}."

#. placeholders: {money_text}
msgid ""
"Owed: {money_text}. Your carrier holds it there and writes off anything "
"past it. Part of every settlement pays it down. You can also pay it down "
"from cash at any terminal or truck stop."
msgstr ""
"Borç: {money_text}. Taşıyıcı firmanız onu orada tutar, fazlasını siler. Her "
"hesap kesiminin bir kısmı onu azaltır. Herhangi bir terminalde veya tır "
"parkında nakitle de ödeyebilirsiniz."

#. one sentence of a longer line
msgid "Part of every settlement pays it down."
msgstr "Her hesap kesiminin bir kısmı onu azaltır."

#. one sentence of a longer line
msgid "You can also pay it down from cash at any terminal or truck stop."
msgstr ""
"Herhangi bir terminalde veya tır parkında nakitle de ödeyebilirsiniz."

#. placeholders: {money_text}, {money_text2}
#. one sentence of a longer line
msgid "Owed: {money_text} of {money_text2}."
msgstr "Borç: {money_text}, sınır {money_text2}."


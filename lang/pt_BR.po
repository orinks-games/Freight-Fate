msgid ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       play\n"
"  freightfate --smoke               boot, render five frames, exit (CI "
"check)\n"
"  freightfate --headless            no window, no speech\n"
"  freightfate --controller-diagnostics\n"
"                                    log controller events, both layers\n"
"\n"
"Drive tools:\n"
"  --playtest-road --find FEATURE    start at a road feature or departure "
"gate\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all scans every\n"
"                                    launchable road family and current "
"world instance.\n"
"                                    Destination is\n"
"                                    the delivery off-ramp at the end of the\n"
"                                    route; departure scans a small route "
"sample\n"
"                                    for loaded facility exits by default. "
"Use\n"
"                                    --routes all for an exhaustive "
"inventory;\n"
"                                    each result prints a direct --facility "
"launch\n"
"                                    that does not rescan the world. State\n"
"                                    transitions requiring a live player "
"history are not road-launchable;\n"
"                                    --from/--to/--seed/--scan and\n"
"                                    the assist switches refine the search\n"
"  --ai                               with a selected road scenario, use "
"paced\n"
"                                    player controls in the real window; "
"live\n"
"                                    player-facing speech streams to the "
"terminal\n"
"  --playtest-sandbox [--launch]     a data directory that cannot reach the\n"
"                                    owner's account; --dir/--reset/--print\n"
"  --list-break-scenarios            name every adversarial scenario\n"
"  --list-speech-backends            name every screen reader and voice "
"found\n"
"  --break-scenario NAME             run one, --transcript to hear it\n"
"  --break-battery                   run them all and print the verdicts\n"
"  --agent-server                    the real game with an MCP server on "
"stdio,\n"
"                                    so an AI agent can play it (sandboxed;\n"
"                                    --reset for a fresh sandbox; add\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    to boot straight into a staged drive;\n"
"                                    --operator-keys keeps the window up and\n"
"                                    lets the operator's keyboard in, to "
"play\n"
"                                    alongside the agent; --staging uses its\n"
"                                    own directory and its own driver on the\n"
"                                    staging site, cloud backup on)\n"
"  --key-probe [--seconds N]         show what your keyboard delivers to the "
"game,\n"
"                                    for a screen reader that re-sends held "
"keys\n"
"                                    (JAWS): hold each arrow key for a few "
"seconds;\n"
"                                    it speaks its findings and writes a log\n"
"  --log PATH                        session log for the watcher"
msgstr ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       jogar\n"
"  freightfate --smoke               inicia, desenha cinco quadros e sai "
"(verificação de CI)\n"
"  freightfate --headless            sem janela, sem fala\n"
"  freightfate --controller-diagnostics\n"
"                                    registra eventos do controle, nas duas "
"camadas\n"
"\n"
"Ferramentas de direção:\n"
"  --playtest-road --find FEATURE    começa num ponto da estrada ou numa "
"portaria de partida\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all varre toda\n"
"                                    família de estrada que pode ser "
"iniciada e cada instância atual do mundo.\n"
"                                    Destination é\n"
"                                    a rampa de saída da entrega no fim da\n"
"                                    rota; departure varre por padrão uma "
"pequena amostra de rotas\n"
"                                    atrás de saídas de instalações "
"carregadas. Use\n"
"                                    --routes all para um inventário "
"completo;\n"
"                                    cada resultado imprime um início direto "
"com --facility\n"
"                                    que não varre o mundo de novo. "
"Transições\n"
"                                    de estado que exigem histórico real do "
"jogador não podem ser iniciadas na estrada;\n"
"                                    --from/--to/--seed/--scan e\n"
"                                    as chaves de assistência refinam a "
"busca\n"
"  --ai                               com um cenário de estrada escolhido, "
"usa controles\n"
"                                    de jogador cadenciados na janela real; "
"a fala\n"
"                                    para o jogador sai ao vivo no terminal\n"
"  --playtest-sandbox [--launch]     uma pasta de dados que não alcança a\n"
"                                    conta do dono; --dir/--reset/--print\n"
"  --list-break-scenarios            lista cada cenário adversarial\n"
"  --list-speech-backends            lista cada leitor de tela e voz "
"encontrados\n"
"  --break-scenario NAME             roda um, --transcript para ouvi-lo\n"
"  --break-battery                   roda todos e imprime os vereditos\n"
"  --agent-server                    o jogo real com um servidor MCP no "
"stdio,\n"
"                                    para um agente de IA jogar (em sandbox;\n"
"                                    --reset para uma sandbox nova; adicione\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    para iniciar direto numa direção "
"preparada;\n"
"                                    --operator-keys mantém a janela aberta "
"e\n"
"                                    deixa entrar o teclado do operador, "
"para jogar\n"
"                                    junto com o agente; --staging usa sua\n"
"                                    própria pasta e seu próprio motorista "
"no\n"
"                                    site de staging, com backup na nuvem "
"ligado)\n"
"  --key-probe [--seconds N]         mostra o que seu teclado entrega ao "
"jogo,\n"
"                                    para um leitor de tela que reenvia "
"teclas seguradas\n"
"                                    (JAWS): segure cada seta por alguns "
"segundos;\n"
"                                    ela fala o que encontrou e grava um "
"registro\n"
"  --log PATH                        registro da sessão para o observador"


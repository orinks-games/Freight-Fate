msgstr "Nenhum aviso recente para repetir."

msgid "No CB chatter to repeat."
msgstr "Nenhuma conversa no PX para repetir."

#. placeholders: {cb_side}
#. one sentence of a longer line
msgid "The CB called an enforcement post {cb_side}."
msgstr "O PX avisou de um posto de fiscalização {cb_side}."

#. placeholders: {cb_side}
msgid "The CB called an enforcement post {cb_side}. You have passed it."
msgstr ""
"O PX avisou de um posto de fiscalização {cb_side}. Você já passou por ele."


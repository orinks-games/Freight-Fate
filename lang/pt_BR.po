msgstr ""
"Pressione o novo botão para {label}, com o right bumper segurado para a "
"segunda camada."

#. placeholders: {label}, {current}
msgid ""
"Press the new button for {label}, with the right bumper held for the second "
"layer. Press {current} again to keep it."
msgstr ""
"Pressione o novo botão para {label}, com o right bumper segurado para a "
"segunda camada. Pressione {current} de novo para mantê-lo."

#. placeholders: {current}
#. one sentence of a longer line
msgid "Press {current} again to keep it."
msgstr "Pressione {current} de novo para mantê-lo."


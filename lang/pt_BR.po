msgid "You have passed it."
msgstr "Você já passou por ele."

msgid "Lane keeping on full."
msgstr "Manutenção de faixa completa."

#. placeholders: {state}
msgid "Lane locator {state}."
msgstr "Localizador de faixa {state}."

msgid "Level road."
msgstr "Estrada plana."

#. placeholders: {grade}, {direction}
msgid "Grade {grade} percent {direction}"
msgstr "Rampa de {grade} por cento {direction}"

#. placeholders: {distance_text}
msgid " for another {distance_text}"

msgstr "北東部"

msgid "Appalachia"
msgstr "アパラチア"

msgid "the Great Lakes"
msgstr "五大湖地方"

msgid "the Upper Midwest"
msgstr "中西部北部"

msgid "the Corn Belt"
msgstr "コーンベルト"


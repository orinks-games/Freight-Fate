msgstr "reserva de mantenimiento"

msgid "trailer program"
msgstr "programa de remolques"

msgid "truck payment reserve"
msgstr "reserva para el pago del camión"

msgid "settlement service fee"
msgstr "comisión por servicio de liquidación"

msgid "weigh station transponder subscription"
msgstr "suscripción al transpondedor de estaciones de pesaje"


msgid "authority compliance reserve"
msgstr "reserva de cumplimiento de la autorización"

msgid "factoring fee"
msgstr "comisión de factoring"

msgid "insurance reserve, surcharged for your driving record"
msgstr "reserva de seguro, con recargo por tu historial de conducción"


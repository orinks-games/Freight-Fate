msgstr "automático, {name}"

msgid "Realistic"
msgstr "Realista"

msgid "Balanced"
msgstr "Equilibrado"

msgid "All assists"
msgstr "Todas las asistencias"

msgid "Custom"
msgstr "Personalizado"


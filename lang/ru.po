msgid ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       play\n"
"  freightfate --smoke               boot, render five frames, exit (CI "
"check)\n"
"  freightfate --headless            no window, no speech\n"
"  freightfate --controller-diagnostics\n"
"                                    log controller events, both layers\n"
"\n"
"Drive tools:\n"
"  --playtest-road --find FEATURE    start at a road feature or departure "
"gate\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all scans every\n"
"                                    launchable road family and current "
"world instance.\n"
"                                    Destination is\n"
"                                    the delivery off-ramp at the end of the\n"
"                                    route; departure scans a small route "
"sample\n"
"                                    for loaded facility exits by default. "
"Use\n"
"                                    --routes all for an exhaustive "
"inventory;\n"
"                                    each result prints a direct --facility "
"launch\n"
"                                    that does not rescan the world. State\n"
"                                    transitions requiring a live player "
"history are not road-launchable;\n"
"                                    --from/--to/--seed/--scan and\n"
"                                    the assist switches refine the search\n"
"  --ai                               with a selected road scenario, use "
"paced\n"
"                                    player controls in the real window; "
"live\n"
"                                    player-facing speech streams to the "
"terminal\n"
"  --playtest-sandbox [--launch]     a data directory that cannot reach the\n"
"                                    owner's account; --dir/--reset/--print\n"
"  --list-break-scenarios            name every adversarial scenario\n"
"  --list-speech-backends            name every screen reader and voice "
"found\n"
"  --break-scenario NAME             run one, --transcript to hear it\n"
"  --break-battery                   run them all and print the verdicts\n"
"  --agent-server                    the real game with an MCP server on "
"stdio,\n"
"                                    so an AI agent can play it (sandboxed;\n"
"                                    --reset for a fresh sandbox; add\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    to boot straight into a staged drive;\n"
"                                    --operator-keys keeps the window up and\n"
"                                    lets the operator's keyboard in, to "
"play\n"
"                                    alongside the agent; --staging uses its\n"
"                                    own directory and its own driver on the\n"
"                                    staging site, cloud backup on)\n"
"  --key-probe [--seconds N]         show what your keyboard delivers to the "
"game,\n"
"                                    for a screen reader that re-sends held "
"keys\n"
"                                    (JAWS): hold each arrow key for a few "
"seconds;\n"
"                                    it speaks its findings and writes a log\n"
"  --log PATH                        session log for the watcher"
msgstr ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       играть\n"
"  freightfate --smoke               запуск, отрисовка пяти кадров, выход "
"(проверка CI)\n"
"  freightfate --headless            без окна, без речи\n"
"  freightfate --controller-diagnostics\n"
"                                    запись событий геймпада, оба слоя\n"
"\n"
"Инструменты вождения:\n"
"  --playtest-road --find FEATURE    старт у элемента дороги или ворот "
"отправления\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all перебирает каждое\n"
"                                    запускаемое семейство дорог и текущий "
"экземпляр мира.\n"
"                                    Destination это\n"
"                                    съезд к месту доставки в конце\n"
"                                    маршрута; departure по умолчанию "
"перебирает небольшую выборку маршрутов\n"
"                                    в поисках выездов с загруженных "
"объектов. Используйте\n"
"                                    --routes all для полного перечня;\n"
"                                    каждый результат печатает прямой запуск "
"--facility,\n"
"                                    который не сканирует мир заново. "
"Переходы\n"
"                                    состояний, требующие живой истории "
"игрока, нельзя запустить с дороги;\n"
"                                    --from/--to/--seed/--scan и\n"
"                                    переключатели помощников уточняют поиск\n"
"  --ai                               с выбранным дорожным сценарием "
"использует размеренное\n"
"                                    управление игрока в настоящем окне; "
"живая\n"
"                                    речь для игрока выводится в терминал\n"
"  --playtest-sandbox [--launch]     каталог данных, который не может "
"достучаться до\n"
"                                    аккаунта владельца; "
"--dir/--reset/--print\n"
"  --list-break-scenarios            назвать каждый проверочный сценарий\n"
"  --list-speech-backends            назвать каждую найденную программу "
"экранного доступа и голос\n"
"  --break-scenario NAME             запустить один, --transcript чтобы "
"услышать его\n"
"  --break-battery                   запустить все и вывести вердикты\n"
"  --agent-server                    настоящая игра с MCP-сервером на stdio,\n"
"                                    чтобы в неё мог играть ИИ-агент (в "
"песочнице;\n"
"                                    --reset для новой песочницы; добавьте\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY],\n"
"                                    чтобы сразу начать с подготовленной "
"поездки;\n"
"                                    --operator-keys оставляет окно открытым "
"и\n"
"                                    пропускает клавиатуру оператора, чтобы "
"играть\n"
"                                    вместе с агентом; --staging использует "
"свой\n"
"                                    каталог и своего водителя на\n"
"                                    тестовом сайте, облачное копирование "
"включено)\n"
"  --key-probe [--seconds N]         показать, что клавиатура передаёт игре,\n"
"                                    для программы экранного доступа, "
"которая повторно отправляет удержанные клавиши\n"
"                                    (JAWS): подержите каждую клавишу со "
"стрелкой несколько секунд;\n"
"                                    проверка озвучит результаты и запишет "
"журнал\n"
"  --log PATH                        журнал сеанса для наблюдателя"


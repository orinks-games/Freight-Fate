msgid ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       play\n"
"  freightfate --smoke               boot, render five frames, exit (CI "
"check)\n"
"  freightfate --headless            no window, no speech\n"
"  freightfate --controller-diagnostics\n"
"                                    log controller events, both layers\n"
"\n"
"Drive tools:\n"
"  --playtest-road --find FEATURE    start at a road feature or departure "
"gate\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all scans every\n"
"                                    launchable road family and current "
"world instance.\n"
"                                    Destination is\n"
"                                    the delivery off-ramp at the end of the\n"
"                                    route; departure scans a small route "
"sample\n"
"                                    for loaded facility exits by default. "
"Use\n"
"                                    --routes all for an exhaustive "
"inventory;\n"
"                                    each result prints a direct --facility "
"launch\n"
"                                    that does not rescan the world. State\n"
"                                    transitions requiring a live player "
"history are not road-launchable;\n"
"                                    --from/--to/--seed/--scan and\n"
"                                    the assist switches refine the search\n"
"  --ai                               with a selected road scenario, use "
"paced\n"
"                                    player controls in the real window; "
"live\n"
"                                    player-facing speech streams to the "
"terminal\n"
"  --playtest-sandbox [--launch]     a data directory that cannot reach the\n"
"                                    owner's account; --dir/--reset/--print\n"
"  --list-break-scenarios            name every adversarial scenario\n"
"  --list-speech-backends            name every screen reader and voice "
"found\n"
"  --break-scenario NAME             run one, --transcript to hear it\n"
"  --break-battery                   run them all and print the verdicts\n"
"  --agent-server                    the real game with an MCP server on "
"stdio,\n"
"                                    so an AI agent can play it (sandboxed;\n"
"                                    --reset for a fresh sandbox; add\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    to boot straight into a staged drive;\n"
"                                    --operator-keys keeps the window up and\n"
"                                    lets the operator's keyboard in, to "
"play\n"
"                                    alongside the agent; --staging uses its\n"
"                                    own directory and its own driver on the\n"
"                                    staging site, cloud backup on)\n"
"  --key-probe [--seconds N]         show what your keyboard delivers to the "
"game,\n"
"                                    for a screen reader that re-sends held "
"keys\n"
"                                    (JAWS): hold each arrow key for a few "
"seconds;\n"
"                                    it speaks its findings and writes a log\n"
"  --log PATH                        session log for the watcher"
msgstr ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       gioca\n"
"  freightfate --smoke               avvia, disegna cinque fotogrammi, esce "
"(controllo CI)\n"
"  freightfate --headless            niente finestra, niente voce\n"
"  freightfate --controller-diagnostics\n"
"                                    registra gli eventi del controller, "
"entrambi i livelli\n"
"\n"
"Strumenti di guida:\n"
"  --playtest-road --find FEATURE    parte da un elemento stradale o da un "
"cancello di partenza\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all esamina ogni\n"
"                                    famiglia stradale avviabile e ogni "
"istanza attuale del mondo.\n"
"                                    Destination è\n"
"                                    la rampa d'uscita della consegna alla "
"fine del\n"
"                                    percorso; departure esamina di base un "
"piccolo campione di percorsi\n"
"                                    per le uscite dalle strutture caricate. "
"Usa\n"
"                                    --routes all per un inventario "
"completo;\n"
"                                    ogni risultato stampa un avvio diretto "
"con --facility\n"
"                                    che non riesamina il mondo. Le\n"
"                                    transizioni di stato che richiedono una "
"storia reale del giocatore non si avviano su strada;\n"
"                                    --from/--to/--seed/--scan e\n"
"                                    gli interruttori delle assistenze "
"affinano la ricerca\n"
"  --ai                               con uno scenario stradale scelto, usa "
"comandi\n"
"                                    del giocatore cadenzati nella finestra "
"reale; la voce\n"
"                                    per il giocatore viene trasmessa dal "
"vivo al terminale\n"
"  --playtest-sandbox [--launch]     una cartella dati che non può "
"raggiungere\n"
"                                    l'account del proprietario; "
"--dir/--reset/--print\n"
"  --list-break-scenarios            elenca ogni scenario avverso\n"
"  --list-speech-backends            elenca ogni screen reader e ogni voce "
"trovati\n"
"  --break-scenario NAME             ne esegue uno, --transcript per "
"sentirlo\n"
"  --break-battery                   li esegue tutti e stampa i verdetti\n"
"  --agent-server                    il gioco vero con un server MCP su "
"stdio,\n"
"                                    così un agente IA può giocarci (in "
"sandbox;\n"
"                                    --reset per una sandbox nuova; aggiungi\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    per partire subito con un viaggio "
"preparato;\n"
"                                    --operator-keys tiene la finestra "
"aperta e\n"
"                                    fa entrare la tastiera dell'operatore, "
"per giocare\n"
"                                    insieme all'agente; --staging usa la "
"sua\n"
"                                    cartella e il suo autista sul\n"
"                                    sito di staging, con il backup nel "
"cloud attivo)\n"
"  --key-probe [--seconds N]         mostra cosa la tua tastiera manda al "
"gioco,\n"
"                                    per uno screen reader che rimanda i "
"tasti tenuti premuti\n"
"                                    (JAWS): tieni premuto ogni tasto "
"freccia per qualche secondo;\n"
"                                    annuncia i risultati e scrive un "
"registro\n"
"  --log PATH                        registro della sessione per "
"l'osservatore"


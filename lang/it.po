msgstr "Nuovo livello!"

#. placeholders: {gained_level}, {title}, {unlock}
msgid ""
"Level up! You are now level {gained_level}: {title}. Unlock: {unlock}"
msgstr ""
"Nuovo livello! Ora sei al livello {gained_level}: {title}. Sblocco: {unlock}"

#. placeholders: {gained_level}, {title}
#. one sentence of a longer line
msgid "You are now level {gained_level}: {title}."
msgstr "Ora sei al livello {gained_level}: {title}."

#. placeholders: {level}, {title}

msgstr ""
"{deliveries} {deliveries:consegna|consegne}, {f3} per cento in orario."

#. placeholders: {f}, {owed_text}, {f2}
#. one sentence of a longer line
msgid "{f} experience.{owed_text} Reputation {f2} out of 100."
msgstr "{f} punti esperienza.{owed_text} Reputazione {f2} su 100."

#. placeholders: {grouped}, {grouped2}

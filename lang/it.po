#~ msgstr ""
#~ "Fai i carichi assegnati senza sbavature, così abilitazioni e servizio "
#~ "diventano più fiducia della centrale."

#~ msgid "Regional progress comes from clean, repeatable service."
#~ msgstr "I progressi regionali vengono da un servizio pulito e ripetibile."

#~ msgid "Short, forgiving freight is still the smartest first move."
#~ msgstr "Carichi brevi e indulgenti restano la prima mossa più furba."

#~ msgid "First-week trust starts with clean service."
#~ msgstr "La fiducia della prima settimana comincia con un servizio pulito."

#~ msgid "Run reliable lanes before chasing specialty freight."
#~ msgstr "Fai rotte affidabili prima di inseguire carichi speciali."

#~ msgid ""
#~ "Business status has the truck buy-in available if you want more "

"Level up! You are now level {gained_level}: {title}. Unlock: {unlock}"
msgstr ""
"Niveau supérieur ! Vous êtes maintenant niveau {gained_level} : {title}. "
"Débloqué : {unlock}"

#. placeholders: {gained_level}, {title}
#. one sentence of a longer line

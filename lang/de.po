"Weiter mit {drive_name}: {weight_tons} Tonnen {label} nach {destination}. "
"{progress} {hours_used} von {deadline_game_h} Stunden. {now}. "
"{transmission} {report_lead}. {speed_control}{engine} {brake}"

#. placeholders: {progress}, {hours_used}, {deadline_game_h}

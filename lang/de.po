msgstr "{progress} {hours_used} von {deadline_game_h} Stunden."

#. placeholders: {pickup_facility_text}
msgid ""
"Pickup dispatch: deadhead from the terminal to {pickup_facility_text}. "
msgstr "Abholauftrag: Leerfahrt vom Depot nach {pickup_facility_text}. "

#. placeholders: {destination_facility_text}

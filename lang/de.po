"Weiter mit {drive_name}: {weight_tons} Tonnen {label} nach {destination}."

#. placeholders: {drive_name}, {weight_tons}, {label}, {destination}, {progress}, {hours_used}, {deadline_game_h}, {now}, {transmission}, {report_lead}, {speed_control}, {engine}, {brake}

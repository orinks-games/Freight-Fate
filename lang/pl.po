msgid ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       play\n"
"  freightfate --smoke               boot, render five frames, exit (CI "
"check)\n"
"  freightfate --headless            no window, no speech\n"
"  freightfate --controller-diagnostics\n"
"                                    log controller events, both layers\n"
"\n"
"Drive tools:\n"
"  --playtest-road --find FEATURE    start at a road feature or departure "
"gate\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all scans every\n"
"                                    launchable road family and current "
"world instance.\n"
"                                    Destination is\n"
"                                    the delivery off-ramp at the end of the\n"
"                                    route; departure scans a small route "
"sample\n"
"                                    for loaded facility exits by default. "
"Use\n"
"                                    --routes all for an exhaustive "
"inventory;\n"
"                                    each result prints a direct --facility "
"launch\n"
"                                    that does not rescan the world. State\n"
"                                    transitions requiring a live player "
"history are not road-launchable;\n"
"                                    --from/--to/--seed/--scan and\n"
"                                    the assist switches refine the search\n"
"  --ai                               with a selected road scenario, use "
"paced\n"
"                                    player controls in the real window; "
"live\n"
"                                    player-facing speech streams to the "
"terminal\n"
"  --playtest-sandbox [--launch]     a data directory that cannot reach the\n"
"                                    owner's account; --dir/--reset/--print\n"
"  --list-break-scenarios            name every adversarial scenario\n"
"  --list-speech-backends            name every screen reader and voice "
"found\n"
"  --break-scenario NAME             run one, --transcript to hear it\n"
"  --break-battery                   run them all and print the verdicts\n"
"  --agent-server                    the real game with an MCP server on "
"stdio,\n"
"                                    so an AI agent can play it (sandboxed;\n"
"                                    --reset for a fresh sandbox; add\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY]\n"
"                                    to boot straight into a staged drive;\n"
"                                    --operator-keys keeps the window up and\n"
"                                    lets the operator's keyboard in, to "
"play\n"
"                                    alongside the agent; --staging uses its\n"
"                                    own directory and its own driver on the\n"
"                                    staging site, cloud backup on)\n"
"  --key-probe [--seconds N]         show what your keyboard delivers to the "
"game,\n"
"                                    for a screen reader that re-sends held "
"keys\n"
"                                    (JAWS): hold each arrow key for a few "
"seconds;\n"
"                                    it speaks its findings and writes a log\n"
"  --log PATH                        session log for the watcher"
msgstr ""
"freightfate -- Freight Fate\n"
"\n"
"  freightfate                       gra\n"
"  freightfate --smoke               uruchom, narysuj pięć klatek, wyjdź "
"(test CI)\n"
"  freightfate --headless            bez okna, bez mowy\n"
"  freightfate --controller-diagnostics\n"
"                                    zapisuj zdarzenia kontrolera, obie "
"warstwy\n"
"\n"
"Narzędzia jazdy:\n"
"  --playtest-road --find FEATURE    zacznij przy elemencie drogi lub bramie "
"wyjazdu\n"
"                                    (downgrade, upgrade, zone, limit-drop,\n"
"                                    stop, scale, curve, interchange, toll,\n"
"                                    chain-law, destination, departure, "
"all); all przeszukuje każdą\n"
"                                    rodzinę dróg do uruchomienia i bieżącą "
"instancję świata.\n"
"                                    Destination to\n"
"                                    zjazd do dostawy na końcu\n"
"                                    trasy; departure domyślnie przeszukuje "
"małą próbkę tras\n"
"                                    pod kątem wyjazdów z załadowanych "
"zakładów. Użyj\n"
"                                    --routes all dla pełnego spisu;\n"
"                                    każdy wynik wypisuje bezpośrednie "
"uruchomienie --facility,\n"
"                                    które nie przeszukuje świata ponownie. "
"Przejść stanów\n"
"                                    wymagających prawdziwej historii gracza "
"nie da się uruchomić na drodze;\n"
"                                    --from/--to/--seed/--scan i\n"
"                                    przełączniki asystentów zawężają "
"wyszukiwanie\n"
"  --ai                               przy wybranym scenariuszu drogi używaj "
"sterowania\n"
"                                    gracza w rzeczywistym tempie w "
"prawdziwym oknie; mowa\n"
"                                    dla gracza płynie na żywo do terminala\n"
"  --playtest-sandbox [--launch]     katalog danych, który nie może dotrzeć "
"do\n"
"                                    konta właściciela; "
"--dir/--reset/--print\n"
"  --list-break-scenarios            wymień każdy scenariusz testów "
"skrajnych\n"
"  --list-speech-backends            wymień każdy znaleziony czytnik ekranu "
"i głos\n"
"  --break-scenario NAME             uruchom jeden, --transcript, żeby go "
"usłyszeć\n"
"  --break-battery                   uruchom wszystkie i wypisz werdykty\n"
"  --agent-server                    prawdziwa gra z serwerem MCP na stdio,\n"
"                                    żeby agent AI mógł w nią grać (w "
"piaskownicy;\n"
"                                    --reset dla świeżej piaskownicy; dodaj\n"
"                                    --find FEATURE [--from CITY] [--to "
"CITY],\n"
"                                    żeby od razu wystartować w "
"przygotowanej jeździe;\n"
"                                    --operator-keys zostawia okno widoczne "
"i\n"
"                                    wpuszcza klawiaturę operatora, żeby "
"grał\n"
"                                    razem z agentem; --staging używa "
"własnego\n"
"                                    katalogu i własnego kierowcy na\n"
"                                    stronie testowej, z kopią zapasową w "
"chmurze)\n"
"  --key-probe [--seconds N]         pokaż, co twoja klawiatura przekazuje "
"grze,\n"
"                                    dla czytnika ekranu, który ponownie "
"wysyła przytrzymane klawisze\n"
"                                    (JAWS): przytrzymaj każdą strzałkę "
"przez kilka sekund;\n"
"                                    sonda mówi, co ustaliła, i zapisuje "
"dziennik\n"
"  --log PATH                        dziennik sesji dla obserwatora"

